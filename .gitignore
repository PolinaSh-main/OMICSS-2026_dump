# =====================================================================
#  OMICSS-2026 — what does NOT belong in git
#
#  Rule of thumb: git stores code, configs and small text results.
#  Everything that a pipeline can regenerate stays on the server only.
# =====================================================================


# ---------------------------------------------------------------------
#  Nextflow
# ---------------------------------------------------------------------

work/
.nextflow/
.nextflow.log*

# execution reports (regenerated on every run)
report*.html
timeline*.html
trace*.txt
dag*.html


# ---------------------------------------------------------------------
#  Cluster / job logs
# ---------------------------------------------------------------------

logs/
log/
slurm-*.out
*.err
*.out


# ---------------------------------------------------------------------
#  Python
# ---------------------------------------------------------------------

.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/


# ---------------------------------------------------------------------
#  Raw / intermediate genomics data
# ---------------------------------------------------------------------

# reads & alignments
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sam
*.bam
*.bai
*.cram

# variants
*.vcf
*.vcf.gz
*.tbi
*.gvcf
*.gvcf.gz

# PLINK binaries (.bim/.bed are huge; .fam is small and kept on purpose)
*.bed
*.bim
*.nosex

# ADMIXTURE allele-frequency matrices (huge; .Q is small and kept)
*.P

# reference / index files
*.fa
*.fa.*
*.fasta
*.gff3
*.gtf

# bulk RNA-seq input tables (course-provided, re-downloadable)
enrichment_project/dataset/
*.gmt

# single-cell / expression matrices
*.h5ad
*.h5
*.mtx
*.mtx.gz
*.RData
*.rds

# FST per-SNP output (hundreds of thousands of rows per comparison;
# the summary tables next to them ARE tracked)
*.weir.fst
*.windowed.weir.fst


# ---------------------------------------------------------------------
#  Legacy layout, left in place on the server
#
#  Before the restructure everything lived under
#  grapewines_project/admixture/. The tracked files moved to
#  pipelines/ and results/, but the ADMIXTURE .Q/.P output, the work
#  directories and the run logs were never in git and are still sitting
#  in the old tree on the cluster.
#
#  Ignoring it keeps `git status` readable and, more to the point,
#  keeps `git clean -fd` away from ADMIXTURE output that cannot be
#  recovered from this repository.
# ---------------------------------------------------------------------

grapewines_project/admixture/


# ---------------------------------------------------------------------
#  Explicitly kept (small, and useful to review in a diff)
# ---------------------------------------------------------------------

!*.fam
!**/cv*.tsv
!**/order_Q*.tsv


# ---------------------------------------------------------------------
#  OS noise
# ---------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# Scratch area for the SNPhylo run: an uncompressed 190 MB VCF, a GDS and
# SLURM logs. Everything in it is regenerated by pipelines/05_tree.
tree_rooted/
