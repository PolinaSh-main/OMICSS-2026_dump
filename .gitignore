# =====================================================================
#  OMICSS-2026 — what does NOT belong in git
#
#  Rule of thumb: git stores code, configs and small text results.
#  Everything that a pipeline can regenerate stays on the server only.
# =====================================================================


# ---------------------------------------------------------------------
#  Nextflow
# ---------------------------------------------------------------------

work/
.nextflow/
.nextflow.log*

# execution reports (regenerated on every run)
report*.html
timeline*.html
trace*.txt
dag*.html


# ---------------------------------------------------------------------
#  Cluster / job logs
# ---------------------------------------------------------------------

logs/
log/
slurm-*.out
*.err
*.out


# ---------------------------------------------------------------------
#  Python
# ---------------------------------------------------------------------

.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/


# ---------------------------------------------------------------------
#  Raw / intermediate genomics data
# ---------------------------------------------------------------------

# reads & alignments
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sam
*.bam
*.bai
*.cram

# variants
*.vcf
*.vcf.gz
*.tbi
*.gvcf
*.gvcf.gz

# PLINK binaries (.bim/.bed are huge; .fam is small and kept on purpose)
*.bed
*.bim
*.nosex

# ADMIXTURE allele-frequency matrices (huge; .Q is small and kept)
*.P

# reference / index files
*.fa
*.fa.*
*.fasta
*.gff3
*.gtf

# bulk RNA-seq input tables (course-provided, re-downloadable)
enrichment_project/dataset/
*.gmt

# single-cell / expression matrices
*.h5ad
*.h5
*.mtx
*.mtx.gz
*.RData
*.rds

# FST per-SNP output (hundreds of thousands of rows per comparison;
# the summary tables next to them ARE tracked)
*.weir.fst
*.windowed.weir.fst


# ---------------------------------------------------------------------
#  Explicitly kept (small, and useful to review in a diff)
# ---------------------------------------------------------------------

!*.fam
!**/cv*.tsv
!**/order_Q*.tsv


# ---------------------------------------------------------------------
#  OS noise
# ---------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
