nextflow.enable.dsl=2


params.outdir = "${baseDir}/results"


process {

    executor = 'slurm'

    shell = [
        '/bin/bash',
        '-euo',
        'pipefail'
    ]

    errorStrategy = 'terminate'

    cpus = 4
    memory = '16 GB'
    time = '2h'

    clusterOptions = '--output=logs/%x_%j.out --error=logs/%x_%j.err'


    withName: QC {

        cpus = 2
        memory = '8 GB'
        time = '1h'
    }


    withName: DOUBLETS {

        cpus = 4
        memory = '16 GB'
        time = '2h'
    }


    withName: MERGE {

        cpus = 2
        memory = '16 GB'
        time = '1h'
    }


    withName: NORMALIZE {

        cpus = 4
        memory = '32 GB'
        time = '2h'
    }


    withName: HARMONY {

        cpus = 4
        memory = '32 GB'
        time = '2h'
    }
}


timeline {

    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}


report {

    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}


trace {

    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
}


dag {

    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}