/*
 * ---------------------------------------------------------------------
 *  Shared configuration for every grapevine pipeline.
 *
 *  Each pipeline includes this file from its own nextflow.config:
 *
 *      includeConfig "../../conf/base.config"
 *
 *  and then only declares what is specific to itself.
 * ---------------------------------------------------------------------
 */


params {

    /*
     * Root of this repository checkout on the server.
     *
     * Every pipeline lives in  <project_root>/pipelines/<name>/,
     * so two levels up from projectDir is the root.
     *
     * Override with  --project_root  if the pipeline is launched
     * from somewhere unusual.
     */

    project_root = "${projectDir}/../.."


    /*
     * Files that are shared between pipelines and small enough
     * to live in git.
     */

    fam      = "${params.project_root}/reference/cauc_filtered.final.fam"

    metadata = "${params.project_root}/reference/cauc_grape_metadata.csv"


    /*
     * Course-wide read-only data provided by the instructors.
     * Not part of this repository.
     */

    shared_data = "/mnt/nas1/proj/omicss26/gp3"

    vcf         = "${params.shared_data}/data/vcf/cauc_filtered.final.vcf.gz"


    /*
     * Where published results go. Kept inside the repo so that
     * small tables and figures are versioned together with the code.
     */

    outdir = "${params.project_root}/results"


    /*
     * Nextflow execution reports (git-ignored).
     */

    report_dir = "${projectDir}/log"

}


process {

    executor = "slurm"

    shell = ["/bin/bash", "-euo", "pipefail"]

    /*
     * Restart once on a node-level failure, then give up so that a
     * genuine error is not retried forever.
     */

    errorStrategy = { task.attempt <= 1 ? "retry" : "finish" }

    maxRetries = 1

    cpus = 1

    memory = "4 GB"

    time = "4h"

}


executor {

    queueSize = 20

}


profiles {

    /*
     * Default. Everything goes to SLURM, nothing heavy runs on the
     * login node.
     */

    slurm {

        process.executor = "slurm"

    }


    /*
     * For smoke tests on a tiny input, or on a machine without SLURM.
     */

    local {

        process.executor = "local"

    }

}


timeline {

    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/timeline.html"

}


report {

    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/report.html"

}


trace {

    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/trace.txt"

}


dag {

    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/dag.html"

}
