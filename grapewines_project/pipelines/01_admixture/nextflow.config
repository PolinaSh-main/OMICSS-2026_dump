includeConfig "../../conf/base.config"


params {

    /*
     * ADMIXTURE raw output: cauc_filtered.final.<K>.Q / .P and the
     * stdout logs that carry the CV errors.
     *
     * These live on the server only (too large / regenerable), so the
     * path points outside the repository.
     */

    admixture_dir = "/mnt/nas0/user/polina.shevyakova/grapewines_project/admixture/results"

    admixture_log_dir = "${params.admixture_dir}/log"


    outdir = "${params.project_root}/results/admixture"

}


process {

    withName: EXTRACT_CV {
        cpus   = 1
        memory = "2 GB"
    }

    withName: PLOT_CV {
        cpus   = 1
        memory = "2 GB"
    }

    withName: BUILD_ORDERS {
        cpus   = 1
        memory = "4 GB"
    }

    withName: PLOT_ADMIXTURE_GRID {
        cpus   = 2
        memory = "8 GB"
    }

}
