includeConfig "../../conf/base.config"


params {

    /*
     * ADMIXTURE raw output: cauc_filtered.final.<K>.Q / .P and the
     * stdout logs that carry the CV errors.
     *
     * ADMIXTURE writes these into the working directory of the job
     * that ran it, which for this project was a per-student folder
     * inside the shared course tree. The .P matrices are ~50 MB each
     * and stay there; only the .Q are small enough to version.
     */

    admixture_dir = "/mnt/nas1/proj/omicss26/gp3/admixture/results/polina_sh"

    admixture_log_dir = "${params.admixture_dir}/log"


    outdir = "${params.project_root}/results/admixture"

}


process {

    withName: EXTRACT_CV {
        cpus   = 1
        memory = "2 GB"
    }

    withName: PLOT_CV {
        cpus   = 1
        memory = "2 GB"
    }

    withName: BUILD_ORDERS {
        cpus   = 1
        memory = "4 GB"
    }

    withName: PLOT_ADMIXTURE_GRID {
        cpus   = 2
        memory = "8 GB"
    }

}
