includeConfig "../../conf/base.config"


params {

    k = 7


    /*
     * Samples drawn from each group. 0 means "the size of the smallest
     * group", which at K = 7 is K4 with 12 -- that group is then taken
     * whole and the other six are cut down to match it.
     */

    subsample_n = 0


    /*
     * Independent draws. One draw is arbitrary: the twelve samples
     * taken out of K6's forty-nine could happen to be unusually close
     * together or unusually spread out. Ten draws turn a single number
     * into a mean with a spread, and the spread is what says whether
     * the 21 pairs can be ranked at all.
     *
     * Cost is linear -- 21 vcftools passes per draw.
     */

    replicates = 10


    seed = 20260813

}


process {

    withName: DRAW_SUBSAMPLES {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

    /*
     * bcftools reads all 2.1 GB and writes roughly a third of it.
     */

    withName: SUBSET_VCF {
        cpus   = 2
        memory = "8 GB"
        time   = "4h"
    }

    /*
     * 21 x replicates of these. They are I/O bound on the subset VCF
     * rather than memory hungry.
     */

    withName: PAIRWISE_FST {
        cpus   = 1
        memory = "4 GB"
        time   = "3h"
    }

    withName: GROUP_PI {
        cpus   = 1
        memory = "4 GB"
        time   = "3h"
    }

    withName: COLLECT {
        cpus   = 1
        memory = "4 GB"
        time   = "30m"
    }

}


executor {

    /*
     * 210 FST tasks plus 77 pi tasks are submitted at once. Without a
     * cap they all hit the queue together and crowd out everyone else
     * on a shared teaching cluster.
     */

    queueSize = 24

}
