includeConfig "../../conf/base.config"


params {

    /*
     * Which FST run to read. Must match a directory produced by
     * pipelines/03_fst.
     */

    k = 7


    /*
     * "all", or e.g. "K1_vs_K3" / "K1_vs_K3,K2_vs_K5"
     */

    comparisons = "all"


    /* ----------------------------------------------------------------
     *  Windowing
     * ---------------------------------------------------------------- */

    window = 50000

    /*
     * A window built from a handful of SNPs can reach a high mean FST
     * by chance, so sparse windows are dropped before ranking.
     */

    min_snps = 20

    /*
     * Fraction of windows called outlying.
     */

    top_fraction = 0.01

    /*
     * Two outlier windows this far apart or closer become one region.
     * At the default they must be adjacent or separated by one gap.
     */

    max_gap = 50000


    /* ----------------------------------------------------------------
     *  Gene annotation
     * ---------------------------------------------------------------- */

    gene_annotation_dir = "/mnt/nas1/proj/omicss26/gp3/gene_annotation/reference"

    gff = "${params.gene_annotation_dir}/PN40024.v4.1.REF.gff3"

    b2g = "${params.gene_annotation_dir}/PN40024.v4.1.REF.b2g.tsv"

    /*
     * Genes this far outside a region are still reported, with their
     * distance recorded, because the causal variant need not sit in
     * the window that happened to cross the threshold.
     */

    flank = 10000

    top_regions = 5

    genes_per_region = 2

}


process {

    withName: WINDOW_FST {
        cpus   = 1
        memory = "8 GB"
        time   = "1h"
    }

    withName: MERGE_REGIONS {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

    /*
     * The GFF3 is parsed line by line, but the gene table and the
     * Blast2GO table are both held in memory.
     */

    withName: ANNOTATE_REGIONS {
        cpus   = 1
        memory = "8 GB"
        time   = "1h"
    }

    withName: SELECT_GENES {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

}
