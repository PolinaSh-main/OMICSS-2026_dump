includeConfig "../../conf/base.config"


params {

    /* ----------------------------------------------------------------
     *  Input
     *
     *  The only approved input for the rooted tree. It was built and
     *  validated before the task was assigned: do not substitute the
     *  earlier 412-sample unrooted VCF, do not add ZZ01 again, do not
     *  rename samples.
     * ---------------------------------------------------------------- */

    vcf_rooted = "${params.shared_data}/phylogeny/rooted/input/cauc_rooted_tree_input.413samples.vcf.gz"

    expect_samples = 413

    expect_variants = 119195

    outgroup = "ZZ01"


    /* ----------------------------------------------------------------
     *  SNPhylo
     *
     *  The installation named in the task brief,
     *  /mnt/nas0/proj/vine/user_projects/armaria/snphylo_prog/, sits in
     *  a directory owned by group "vine" and is not readable from this
     *  account. This is the copy inside the course project, which is
     *  the one the group's earlier runs used; its snphylo.vcf.sh has
     *  BASE_DIR hard-coded to this path.
     * ---------------------------------------------------------------- */

    snphylo = "${params.shared_data}/phylogeny/software/snphylo/snphylo.vcf.sh"

    snphylo_r_libs = "${params.shared_data}/phylogeny/software/snphylo/R_LIBS"

    prefix = "cauc_rooted"


    /* ----------------------------------------------------------------
     *  Fixed analysis settings
     *
     *  These are prescribed by the task and must not be changed without
     *  the mentor agreeing; any alternative run is a separate,
     *  explicitly labelled sensitivity analysis.
     * ---------------------------------------------------------------- */

    maf = 0.10

    missing = 0.10

    /*
     * The group's earlier attempt used 0.18 and kept 55,275 sites,
     * which SNPhylo refuses to turn into a tree (its limit is 50,000).
     * At 0.10 this input keeps 12,848.
     */

    ld = 0.10

    last_autosome = 19

    bootstrap = 100


    /* ----------------------------------------------------------------
     *  Resuming
     *
     *  dnaml on 413 taxa runs for hours. Set both of these to skip
     *  SNPHYLO_ML and start at the bootstrap.
     * ---------------------------------------------------------------- */

    ml_tree = null

    phylip = null


    /* ----------------------------------------------------------------
     *  Annotation
     * ---------------------------------------------------------------- */

    k = 7

    /*
     * Row order in the .Q file follows the .fam of the ADMIXTURE run,
     * so the two must come from the same run. These are the committed
     * copies of exactly that pair.
     */

    q_file = "${params.project_root}/results/admixture/Q/cauc_filtered.final.${params.k}.Q"

    min_q = 0.75


    /* ----------------------------------------------------------------
     *  Figures
     * ---------------------------------------------------------------- */

    layouts = "fan,rectangular"

    /*
     * all         every tip, admixed samples in grey
     * groups_only the seven assigned groups and the outgroup
     *
     * Both by default. The task brief wants the admixed samples left
     * visible -- where they fall is informative -- while the group
     * figures read better without 252 grey dots on them.
     */

    tip_sets = "all,groups_only"

    /*
     * Bootstrap values below this are not drawn: with 411 internal
     * nodes the figure is otherwise unreadable.
     */

    min_support = 70

}


process {

    withName: PREFLIGHT {
        cpus   = 1
        memory = "4 GB"
        time   = "30m"
    }

    /*
     * The SNPhylo stage is two very different jobs in one: a few
     * minutes of threaded R for the LD pruning, then many hours of
     * single-threaded dnaml. Measured on this input, dnaml places
     * roughly 30 taxa per five minutes early on and slows down as the
     * tree grows, which works out at six to eight hours for 413.
     *
     * Asking for more than a couple of cores would only hold them idle.
     */

    withName: SNPHYLO_ML {
        cpus   = 2
        memory = "32 GB"
        time   = "1d"
    }

    /*
     * 100 independent replicates, so this is the stage worth throwing
     * cores at. bootstrap_tree.R is told exactly this many.
     */

    withName: BOOTSTRAP {
        cpus   = 32
        memory = "128 GB"
        time   = "12h"
    }

    withName: VALIDATE {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

    withName: ANNOTATE {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

    /*
     * The rectangular phylogram is 413 labelled tips tall, which is a
     * large canvas for matplotlib to render.
     */

    withName: PLOT {
        cpus   = 1
        memory = "8 GB"
        time   = "1h"
    }

}
