includeConfig "../../conf/base.config"


params {

    /*
     * PLINK prefix, without .bed/.bim/.fam.
     *
     * The shared course copy is
     * /mnt/nas1/proj/omicss26/gp3/data/plink/cauc_filtered.final
     */

    bfile = "/mnt/nas1/proj/omicss26/gp3/data/plink/cauc_filtered.final"

    /*
     * Grapevine has 19 chromosomes; PLINK assumes human unless told.
     */

    chr_set = 19


    /* ----------------------------------------------------------------
     *  LD pruning
     *
     *  Linked SNPs repeat the same signal, which both distorts branch
     *  lengths and inflates bootstrap support. Pruning first is what
     *  makes the support values mean anything.
     * ---------------------------------------------------------------- */

    ld_window = 50

    ld_step = 5

    ld_r2 = 0.2


    /* ----------------------------------------------------------------
     *  Tree
     * ---------------------------------------------------------------- */

    /*
     * Bootstrap replicates. Each one is a full distance matrix and a
     * full NJ pass, so this is what the runtime is spent on. Set to 0
     * for a quick look; keep 100 for anything that goes in a report.
     */

    bootstrap = 100

    /*
     * midpoint | outgroup | none
     *
     * There is no outgroup in this dataset -- every sample is Vitis
     * vinifera -- so the tree is midpoint rooted. That is a drawing
     * convention, not an evolutionary claim about the root.
     */

    root = "midpoint"

    outgroup = null

    seed = 1


    /* ----------------------------------------------------------------
     *  Figure
     * ---------------------------------------------------------------- */

    /*
     * Comma-separated list; one figure per entry.
     * "assignment" colours by ADMIXTURE group and needs --groups.
     */

    color_by = "Geographic origin by country,Genetic background,Utilization"

    /*
     * sample_q_values_K<K>.tsv from 03_fst, for color_by = assignment.
     */

    groups = null

    layout = "circular"

    /*
     * linear    true branch lengths
     * cladogram topology only
     *
     * Both, because on an individual-level NJ tree each sample's own
     * branch is far longer than the splits between groups, so the
     * linear figure collapses towards the centre and the topology is
     * only legible on the cladogram.
     */

    scale = "linear,cladogram"

    /*
     * 412 tip names around a circle are unreadable. Only worth turning
     * on for a subset.
     */

    show_labels = false

}


process {

    withName: LD_PRUNE {
        cpus   = 2
        memory = "8 GB"
        time   = "1h"
    }

    withName: DISTANCE_MATRIX {
        cpus   = 4
        memory = "16 GB"
        time   = "2h"
    }

    /*
     * The bootstrap is four BLAS matrix products per replicate, so it
     * uses whatever threads numpy is given.
     */

    withName: BUILD_TREE {
        cpus   = 8
        memory = "16 GB"
        time   = "6h"
    }

    withName: PLOT_TREE {
        cpus   = 1
        memory = "4 GB"
        time   = "30m"
    }

}
