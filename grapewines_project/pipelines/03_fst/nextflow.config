includeConfig "../../conf/base.config"


params {

    /*
     * Which ADMIXTURE run to analyse. K=7 is the one the group settled
     * on; K=3 exists as the instructors' worked example.
     */

    k = 7


    /*
     * Directory holding cauc_filtered.final.<K>.Q.
     *
     * Point this at your own ADMIXTURE output. The shared course copy
     * is /mnt/nas1/proj/omicss26/gp3/admixture/results.
     */

    admixture_dir = "/mnt/nas0/user/polina.shevyakova/grapewines_project/admixture/results"


    /*
     * A sample joins a group only if its largest ancestry proportion
     * reaches this value; below it the sample counts as admixed.
     */

    min_q = 0.75


    /*
     * Groups smaller than this are not compared at all -- FST between
     * two or three individuals is noise. Groups between this and about
     * five samples are compared but flagged in group_sizes_K<K>.tsv.
     */

    min_group_size = 4


    /*
     * "all", or specific comparisons: "K1:K5" / "K1:K5,K2:K3"
     */

    pairs = "all"


    /*
     * Which column of the summary table the heatmap shows.
     * mean_fst matches the course instructions; weighted_fst is the
     * ratio-of-averages estimator vcftools also reports.
     */

    metric = "mean_fst"

}


process {

    withName: ASSIGN_GROUPS {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

    withName: DESCRIBE_GROUPS {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

    /*
     * vcftools streams the whole VCF once per comparison. It is I/O
     * bound rather than memory hungry, but 21 of them start at once.
     */

    withName: PAIRWISE_FST {
        cpus   = 1
        memory = "4 GB"
        time   = "3h"
    }

    withName: SUMMARIZE_FST {
        cpus   = 1
        memory = "8 GB"
        time   = "1h"
    }

    withName: PLOT_FST_HEATMAP {
        cpus   = 1
        memory = "2 GB"
        time   = "20m"
    }

}
