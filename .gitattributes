# Everything here is executed on a Linux cluster. Keep LF in the working
# tree too, so a script edited on Windows never reaches the server with
# CRLF line endings (a `\r` after the shebang makes bash fail with a
# confusing "bad interpreter" error).

*.sh   text eol=lf
*.py   text eol=lf
*.R    text eol=lf
*.nf   text eol=lf
*.config text eol=lf
*.md   text eol=lf
*.tsv  text eol=lf
*.csv  text eol=lf

# Sample lists fed to vcftools --weir-fst-pop, and PHYLIP/Newick trees
*.txt  text eol=lf
*.tree text eol=lf
*.nwk  text eol=lf

# ADMIXTURE ancestry proportions, read by PLINK and by the Python steps
*.Q    text eol=lf

*.png  binary
*.pdf  binary

# Generated output, not source -- keep it out of the repository language
# statistics (4 FastQC reports were making GitHub call this an HTML project).
*_fastqc.html      linguist-generated=true
grapewines_project/results/**  linguist-generated=true
enrichment_project/*.png       linguist-generated=true
# ADMIXTURE .Q ancestry matrices are numeric data; GitHub was guessing HiveQL.
*.Q                linguist-detectable=false
*.html             linguist-detectable=false
